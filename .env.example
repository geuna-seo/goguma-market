# 이 파일을 복사해서 .env.local 을 만들고 값을 채워주세요.
# Supabase 대시보드 > Project Settings > API Keys 에서 확인할 수 있어요.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 카카오 로컬 API (동네 인증: GPS 좌표 → 행정동 이름). 서버에서만 쓰는 비밀 키예요.
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키 (카카오맵 사용 설정 ON 필요)
KAKAO_REST_API_KEY=
